# ============================================
# KevinAgent - Environment Variables
# ============================================
# Copy this file to .env and fill in your values
# NEVER commit .env to version control

# LLM API Keys (required - at least one)
OPENAI_API_KEY=sk-your-openai-key-here
ANTHROPIC_API_KEY=sk-ant-your-anthropic-key-here
DEEPSEEK_API_KEY=sk-your-deepseek-key-here
MOONSHOT_API_KEY=sk-your-moonshot-key-here
GLM_API_KEY=your-glm-key-here
MIMO_API_KEY=your-mimo-key-here

# Database (overrides config/app.yaml)
# SQLite (default):
# DATABASE_URL=sqlite+aiosqlite:///./kevin.db
#
# MySQL:
# DATABASE_URL=mysql+aiomysql://user:password@localhost:3306/kevin_agent
#
# PostgreSQL:
# DATABASE_URL=postgresql+asyncpg://user:password@localhost:5432/kevin_agent

# Connection pool
DB_POOL_SIZE=5
DB_MAX_OVERFLOW=10

# Server
HOST=0.0.0.0
PORT=8000

# Default model
DEFAULT_PROVIDER=openai
DEFAULT_MODEL=gpt-4o

# Agent settings
MAX_ITERATIONS=30
MAX_MEMORY_ITEMS=100

# Logging
LOG_LEVEL=INFO
